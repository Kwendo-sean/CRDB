# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
APP_BASE_URL=http://localhost
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
TIME_ZONE=Africa/Dar_es_Salaam
WEB_WORKERS=4
CELERY_CONCURRENCY=2
DJANGO_LOG_LEVEL=INFO
DJANGO_CONN_MAX_AGE=60

# Live-event tuning (safe defaults; change only after a spike test)
LEADERBOARD_CACHE_SECONDS=15
SESSION_COOKIE_AGE=50400
RATELIMIT_ENABLE=1
RATELIMIT_ACCESS=12/m
RATELIMIT_ANSWER=60/m
RATELIMIT_STATE=120/m
RATELIMIT_LOGIN=10/m

# PostgreSQL (Docker host name is postgres)
POSTGRES_DB=crdb_learning_week
POSTGRES_USER=crdb
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://crdb:CHANGE_ME@postgres:5432/crdb_learning_week

# Redis (database 0: broker/cache/channel layer)
REDIS_URL=redis://redis:6379/0

# Formal registration
OFFICIAL_REGISTRATION_URL=https://forms.google.com/replace-me
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GOOGLE_WEBHOOK_SECRET=

# PAL AI Jobs
PAL_LAUNCH_URL=https://aijobs.predictiveanalyticslab.ai/learning-week
PAL_BASE_URL=https://aijobs.predictiveanalyticslab.ai
PAL_CALLBACK_SECRET=
PAL_INTEGRATION_SECRET=
PAL_ISSUER=crdb-learning-week
PAL_AUDIENCE=pal-ai-jobs

# Expo / AIoT device API
ACTIVITY_API_KEY=

# Optional outbound email / magic links
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USERNAME=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=learningweek@example.com

# VPS / TLS workflow
DOMAIN=
SSL_EMAIL=
BACKUP_RETENTION_DAYS=14
