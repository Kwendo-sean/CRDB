# Reverse proxy for a server that ALREADY runs nginx on ports 80/443 — for
# example a box hosting several predictiveanalyticslab.ai subdomains.
#
# The Learning Week stack publishes its own nginx on HTTP_PORT (see .env); this
# vhost sits on the host and forwards to it, so participants get a clean
# https://DOMAIN with no port number, and TLS is handled here by certbot.
#
#   sudo cp nginx/host-vhost.conf.template /etc/nginx/sites-available/crdb-learning-week
#   sudo sed -i 's/__DOMAIN__/crdbxpal-learningweek.predictiveanalyticslab.ai/g; s/__PORT__/999/g' \
#        /etc/nginx/sites-available/crdb-learning-week
#   sudo ln -sf /etc/nginx/sites-available/crdb-learning-week /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d crdbxpal-learningweek.predictiveanalyticslab.ai

map $http_upgrade $crdb_connection_upgrade { default upgrade; '' ''; }

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # certbot --nginx rewrites this block to redirect to HTTPS once the
    # certificate is issued; until then the site is reachable over HTTP.
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $crdb_connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 75s;
    }

    # Live quiz sockets idle between questions while the host is speaking.
    location /ws/ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $crdb_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
