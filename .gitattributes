# This repository is developed on Windows and deployed to Linux. Anything the
# server executes or parses must arrive with LF endings: a CRLF shebang makes
# bash fail with "$'\r': command not found", and CRLF leaks into generated .env
# values and Dockerfile RUN lines.
* text=auto eol=lf

# Binaries must never be line-ending converted; a mangled .xlsx or .pdf only
# shows up as a corrupt file after a clone on another platform.
*.pdf   binary
*.xlsx  binary
*.xlsm  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.sqlite3 binary
uv.lock text eol=lf
